# ===== قاعدة البيانات =====
# يجب أن يكون المستخدم مالك الجداول (ينفذ الترحيلات) ويمكنه SET ROLE app_user. لا تستخدم مستخدمًا بخاصية BYPASSRLS للتطبيق.
DATABASE_URL=postgres://ops_owner:CHANGE_ME@localhost:5432/ops
DATABASE_SSL=false
DB_POOL_MAX=15

# ===== الخادم =====
PORT=3000
NODE_ENV=production
# عند التشغيل خلف وكيل عكسي (Nginx) يقدّم HTTPS
TRUST_PROXY=1
SESSION_DAYS=7
UPLOAD_DIR=/var/lib/ops-platform/uploads
MAX_UPLOAD_MB=15
JOB_INTERVAL_MIN=15

# ===== التسجيل وأول مدير =====
# في الإنتاج: أنشئ المدير الأول بالأمر npm run create-admin وأبقِ القيمتين false
ALLOW_SIGNUP=false
FIRST_USER_IS_ADMIN=false

# ===== تكاملات مستقبلية (اتركها فارغة حتى تُعتمد رسميًا) =====
# تُقرأ من الخادم فقط ولا تُرسل إلى المتصفح أبدًا
SAP_PM_BASE_URL=
SAP_PM_USERNAME=
SAP_PM_PASSWORD=
SCADA_HISTORIAN_URL=
SCADA_API_TOKEN=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
