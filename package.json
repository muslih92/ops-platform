{
  "name": "ops-workforce-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "منظومة إدارة وتمكين فريق التشغيل - Operations Workforce Management & Development Platform",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "migrate": "node server/migrate.js",
    "seed:demo": "node server/migrate.js --seed-demo",
    "demo-users": "node server/scripts/demo-users.js",
    "create-admin": "node server/scripts/create-admin.js",
    "dev:server": "node --watch server/index.js",
    "dev:web": "npm --prefix web run dev",
